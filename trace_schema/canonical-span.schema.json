{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical span or call observation version 1",
  "description": "Internal normalized record, not an OTLP ExportTraceServiceRequest. Run validate.py for cross-field rules.",
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "int"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]{0,18})$"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "double"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "bytes"
            },
            "value": {
              "type": "string",
              "contentEncoding": "base64"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "array"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "map"
            },
            "value": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "empty"
            },
            "value": {
              "type": "null"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "identity_kind": {
      "enum": [
        "OTEL",
        "DATASET"
      ]
    },
    "record_kind": {
      "enum": [
        "SPAN",
        "CALL_OBSERVATION"
      ]
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "span_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "parent_span_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_relation": {
      "enum": [
        "ROOT",
        "EXPLICIT",
        "INFERRED",
        "UNKNOWN"
      ]
    },
    "service_namespace": {
      "type": "string"
    },
    "service_name": {
      "type": "string",
      "minLength": 1
    },
    "service_instance_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "span_kind": {
      "enum": [
        "INTERNAL",
        "SERVER",
        "CLIENT",
        "PRODUCER",
        "CONSUMER",
        "UNKNOWN"
      ]
    },
    "start_time_ns": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "end_time_ns": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "duration_ns": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "time_domain": {
      "enum": [
        "UNIX",
        "RELATIVE",
        "UNKNOWN"
      ]
    },
    "timing_quality": {
      "enum": [
        "MEASURED",
        "DERIVED",
        "DURATION_ONLY",
        "SYNTHETIC",
        "UNKNOWN"
      ]
    },
    "status": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "UNSET",
            "OK",
            "ERROR",
            "UNKNOWN"
          ]
        },
        "message": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "span_flags": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        {
          "type": "null"
        }
      ]
    },
    "trace_state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    },
    "resource": {
      "type": "object",
      "properties": {
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "schema_url": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "attributes",
        "schema_url"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "schema_url": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "attributes",
        "schema_url"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "time_ns": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/value"
            }
          },
          "dropped_attributes_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "time_ns",
          "attributes",
          "dropped_attributes_count"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trace_id": {
            "type": "string",
            "minLength": 1
          },
          "span_id": {
            "type": "string",
            "minLength": 1
          },
          "identity_kind": {
            "enum": [
              "OTEL",
              "DATASET"
            ]
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/value"
            }
          },
          "span_flags": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              {
                "type": "null"
              }
            ]
          },
          "trace_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "dropped_attributes_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "trace_id",
          "span_id",
          "identity_kind",
          "attributes",
          "span_flags",
          "trace_state",
          "dropped_attributes_count"
        ],
        "additionalProperties": false
      }
    },
    "dropped_counts": {
      "type": "object",
      "properties": {
        "span_attributes": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "links": {
          "type": "integer",
          "minimum": 0
        },
        "resource_attributes": {
          "type": "integer",
          "minimum": 0
        },
        "scope_attributes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "span_attributes",
        "events",
        "links",
        "resource_attributes",
        "scope_attributes"
      ],
      "additionalProperties": false
    },
    "received_at_unix_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "source": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "record_key": {
          "type": "string",
          "minLength": 1
        },
        "raw_reference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "format",
        "adapter_version",
        "record_key",
        "raw_reference",
        "details"
      ],
      "additionalProperties": false
    },
    "quality_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "identity_kind",
    "record_kind",
    "trace_id",
    "span_id",
    "parent_span_id",
    "parent_relation",
    "service_namespace",
    "service_name",
    "service_instance_id",
    "operation_name",
    "span_kind",
    "start_time_ns",
    "end_time_ns",
    "duration_ns",
    "time_domain",
    "timing_quality",
    "status",
    "span_flags",
    "trace_state",
    "attributes",
    "resource",
    "scope",
    "events",
    "links",
    "dropped_counts",
    "received_at_unix_ns",
    "source",
    "quality_flags"
  ],
  "additionalProperties": false
}
